# ============================================================
#  Eye in the Sky — Backend Environment Variables
#  DO NOT commit this file to git — add .env to .gitignore
# ============================================================

# ------ PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kenneth1998**
POSTGRES_DB=eye_db

# ------ Database URLs ───────────────────────────────────────
# Docker: uses service name "postgres" not localhost
DATABASE_URL=postgresql+asyncpg://postgres:kenneth1998**@postgres:5432/eye_db
DATABASE_URL_SYNC=postgresql://postgres:kenneth1998**@postgres:5432/eye_db

# ------ Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ------ JWT Auth ────────────────────────────────────────────
SECRET_KEY=supersecretastronomyjwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------ AstronomyAPI ────────────────────────────────────────
# Used for rise/set times, events
# Dashboard: https://astronomyapi.com/dashboard
ASTRONOMY_API_KEY=cab32ddba6844d5f8e2ba0c184fc815b

# ------ OpenWeather ─────────────────────────────────────────
# Used for sky visibility scores + dew point warnings
# Get free key: https://home.openweathermap.org/api_keys
WEATHER_API_KEY=your_openweather_api_key_here

# ------ N2YO Satellite Tracking ─────────────────────────────
# Used for satellite pass predictions
# Get free key: https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key_here

# ------ NASA ────────────────────────────────────────────────
# Used for APOD (Astronomy Picture of the Day)
# Get free key: https://api.nasa.gov (instant, no wait)
NASA_API_KEY=DEMO_KEY

# ------ Open Notify (ISS) ───────────────────────────────────
# No key needed — free public API
# Used by skyController.get_iss_position()
OPEN_NOTIFY_ISS_URL=http://api.open-notify.org/iss-now.json

# ------ Celestrak (TLE satellite data) ──────────────────────
# No key needed — free public API
# Used by Celery TLE refresh task every 6 hours
CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle